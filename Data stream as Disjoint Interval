from bisect import bisect_left

class SummaryRanges:

    def __init__(self):
        # Stores disjoint intervals in sorted order: [[start1, end1], [start2, end2], ...]
        self.intervals = []

    def addNum(self, value: int) -> None:
        # Find the insertion point to maintain sorted order
        idx = bisect_left(self.intervals, [value, value])
        
        # 1. Check if 'value' is already within an existing interval [start, end]
        # If idx > 0, check if previous interval's end >= value
        if idx > 0 and self.intervals[idx-1][1] >= value:
            return
        # If value is already inside the interval at idx (unlikely with bisect_left
        # but good for safety), also return
        if idx < len(self.intervals) and self.intervals[idx][0] <= value:
            return
        
        # Check if 'value' can bridge or extend adjacent intervals
        left_merge = (idx > 0 and self.intervals[idx-1][1] + 1 == value)
        right_merge = (idx < len(self.intervals) and self.intervals[idx][0] - 1 == value)
        
        if left_merge and right_merge:
            # Merges two intervals into one: [start_prev, end_next]
            self.intervals[idx-1][1] = self.intervals[idx][1]
            self.intervals.pop(idx)
        elif left_merge:
            # Extends the previous interval's end
            self.intervals[idx-1][1] = value
        elif right_merge:
            # Extends the next interval's start
            self.intervals[idx][0] = value
        else:
            # Insert as a new standalone interval [value, value]
            self.intervals.insert(idx, [value, value])

    def getIntervals(self) -> list[list[int]]:
        return self.intervals
