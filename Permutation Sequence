class Solution:
    def getPermutation(self, n: int, k: int) -> str:
       # Create a list of numbers [1, 2, ..., n]
        numbers = [str(i) for i in range(1, n + 1)]
        
        # Convert k to 0-based index
        k -= 1
        
        # Calculate the initial (n-1)! factorial
        fact = math.factorial(n - 1)
        
        res = []
        for i in range(n - 1, 0, -1):
            # Find the index of the current digit
            index = k // fact
            res.append(numbers.pop(index))
            
            # Update k for the remaining sequence
            k %= fact
            
            # Update factorial for the next position (fact / i)
            fact //= i
            
        # Append the last remaining number
        res.append(numbers[0])
        
        return "".join(res)
      
