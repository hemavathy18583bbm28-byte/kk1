from collections import deque
from typing import List

class Solution:
    def ladderLength(self, beginWord: str, endWord: str, wordList: List[str]) -> int:
        # Convert list to set for O(1) lookups
        wordSet = set(wordList) #
        
        # If endWord is not in the list, no valid sequence exists
        if endWord not in wordSet:
            return 0 #
        
        # Queue for BFS stores tuples of (current_word, level)
        queue = deque([(beginWord, 1)]) #
        
        while queue:
            word, level = queue.popleft()
            
            # Try changing each character of the word
            for i in range(len(word)):
                for char in 'abcdefghijklmnopqrstuvwxyz':
                    next_word = word[:i] + char + word[i+1:] #
                    
                    # If we found the target, return the current level + 1
                    if next_word == endWord:
                        return level + 1 #
                    
                    # If the transformed word is in the dictionary, add to queue
                    if next_word in wordSet:
                        wordSet.remove(next_word) # Remove to mark as visited
                        queue.append((next_word, level + 1))
                        
        return 0 # No path found
     
