class Solution:
    def shortestPalindrome(self, s: str) -> str:
        if not s:
            return ""
        
        # Create the combined string for KMP
        rev_s = s[::-1]
        combined = s + "#" + rev_s
        
        # Build KMP table (Prefix Function)
        n = len(combined)
        table = [0] * n
        for i in range(1, n):
            j = table[i - 1]
            while j > 0 and combined[i] != combined[j]:
                j = table[j - 1]
            if combined[i] == combined[j]:
                j += 1
            table[i] = j
            
        # The last value in table gives the length of the 
        # longest palindromic prefix
        longest_prefix_len = table[-1]
        
        # The suffix to be reversed and added to the front
        suffix = s[longest_prefix_len:]
        return suffix[::-1] + s
    
